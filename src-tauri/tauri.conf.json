{
  "productName": "Blender Config Sync",
  "version": "1.0.0",
  "identifier": "com.mmy.blender-config-sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blender Config Sync",
        "width": 1200,
        "height": 750,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "label": "main"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/app.ico",
      "iconAsTemplate": true,
      "id": "main"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/app.ico"
    ],
    "category": "Utility",
    "shortDescription": "Blender config sync tool",
    "longDescription": "A tool to sync Blender configurations between different versions",
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {}
}